# Copy to `.env` (gitignored).

APP_NAME=telco-assistant
ENVIRONMENT=local

POSTGRES_USER=telco
POSTGRES_PASSWORD=telco
POSTGRES_DB=telco
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# POSTGRES_DSN=postgresql://telco:telco@localhost:5433/telco
# DATABASE_URL=  # Render sets this automatically from the Blueprint DB
VECTOR_BACKEND=pgvector

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# API auth: name:secret pairs (or JSON {"demo":"secret"}).
# Empty allowed only for ENVIRONMENT=local|dev|test|ci.
# Production/staging refuse to start without API_KEYS.
API_KEYS=demo:dev-local-telco-key
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TRUST_PROXY=true

AWS_REGION=eu-west-1
# SECRETS_MANAGER_SECRET_ID=telco/app
